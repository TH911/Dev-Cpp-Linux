[Desktop Entry]
Version=1.0
Type=Application
Name=Dev-C++
Comment=Dev-C++ for NOI Linux
Comment[zh_CN]=适用于 NOI Linux 的 Dev-C++
Exec=/usr/bin/dev-cpp %F
Icon=/usr/share/pixmaps/dev-cpp.ico
Terminal=false
StartupWMClass=DevCppInstalled
NoDisplay=true
Categories=Development;IDE;
MimeType=text/x-c++src;text/x-csrc;text/x-c++hdr;text/x-chdr;
Actions=NewWindow;

[Desktop Action NewWindow]
Name=Open in New Window
Name[zh_CN]=在新窗口打开
Exec=/usr/bin/dev-cpp --new-window %F
