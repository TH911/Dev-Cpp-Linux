[Desktop Entry]
Version=1.0
Type=Application
Name=Dev-Cpp
Comment=Dev-C++ for NOI Linux
Comment[zh_CN]=适用于 NOI Linux 的 Dev-C++
Exec=/usr/bin/devcpp-noi %F
Icon=/usr/share/pixmaps/devcpp-noi.ico
Terminal=false
StartupWMClass=DevCppNoiInstalled
NoDisplay=true
Categories=Development;IDE;
MimeType=text/x-c++src;text/x-csrc;text/x-c++hdr;text/x-chdr;
Actions=NewWindow;

[Desktop Action NewWindow]
Name=Open in New Window
Name[zh_CN]=在新窗口打开
Exec=/usr/bin/devcpp-noi --new-window %F
